# Benchmark caches / raw run logs (regenerable; the curated
# results/*.json and results/*.csv summaries are the actual citable
# artifacts and stay tracked)
geo_coordinate_benchmark/cache/
geo_coordinate_benchmark/*_log.txt
evaluation/*/cache/

# Overture's raw response dumps EVERY candidate in the download window
# (up to 27k+ rows for dense-urban queries) - 257MB in one observed run.
# Far too large to commit; the curated benchmark_results.json (best
# candidate + top alternates per query) is the tracked artifact instead.
geo_coordinate_benchmark/results/overture_results.json